# Copy to .env.local (already git-ignored) and fill these as the extension publisher.
# Use the public key from the Curator Web Store item to keep its extension ID stable.
CURATOR_EXTENSION_PUBLIC_KEY=

# Optional: preserve the ID of an existing unpacked installation during local
# builds. Register its redirect as well; build:release always uses the public key.
CURATOR_DEVELOPMENT_EXTENSION_ID=

# Google: Web application client, Drive API enabled, drive.file scope.
# Register https://<Curator extension ID>.chromiumapp.org/ as the exact redirect URI.
CURATOR_GOOGLE_CLIENT_ID=
CURATOR_GOOGLE_CLIENT_SECRET=

# Dropbox: App key; enable the scopes listed in src/vendor/floccus/OAUTH.md.
# Register the same Curator redirect URI. A Dropbox app secret is not needed.
CURATOR_DROPBOX_CLIENT_ID=
